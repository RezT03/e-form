          <div class="bg-stone-50 px-4 py-3 flex items-center justify-between border-b border-stone-200">
            <label class="inline-flex items-center space-x-2.5 cursor-pointer">
              <input type="checkbox" name="cat_tenda" value="1" <%= tendaItem ? 'checked' : '' %> class="cat-toggle" data-target="body-tenda" <%= isReadOnly ? 'disabled' : '' %>>
              <span class="font-bold text-xs uppercase tracking-wider text-stone-900">3. Tenda (Tratak)</span>
            </label>
            <span class="text-[11px] font-mono text-stone-500">Shade & Canopy</span>
          </div>
          <div id="body-tenda" class="p-4 bg-white <%= tendaItem ? '' : 'hidden' %> space-y-3.5 text-xs">
            <div>
              <label class="block font-semibold uppercase text-stone-700 mb-1">Jumlah / Ukuran <span class="text-red-500">*</span></label>
              <input type="text" name="tenda_qty" placeholder="Misal: 4 Plong / 6x12 Meter" value="<%= tendaItem ? tendaItem.qty_text : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>>
            </div>
            <div>
              <label class="block font-semibold uppercase text-stone-700 mb-1">Keterangan Teknis <span class="text-red-500">*</span></label>
              <textarea name="tenda_notes" rows="2" placeholder="Catatan: dekorasi plafon serut/datar, warna kain (putih-gold), tirai samping, dll." class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>><%= tendaItem ? tendaItem.notes : '' %></textarea>
            </div>
          </div>
        </div>

        <!-- 4. PANGGUNG RIGGING -->
        <% const riggingItem = getItem('panggung_rigging'); %>
        <div class="border border-stone-300 rounded overflow-hidden">
          <div class="bg-stone-50 px-4 py-3 flex items-center justify-between border-b border-stone-200">
            <label class="inline-flex items-center space-x-2.5 cursor-pointer">
              <input type="checkbox" name="cat_panggung_rigging" value="1" <%= riggingItem ? 'checked' : '' %> class="cat-toggle" data-target="body-rigging" <%= isReadOnly ? 'disabled' : '' %>>
              <span class="font-bold text-xs uppercase tracking-wider text-stone-900">4. Panggung Rigging</span>
            </label>
            <span class="text-[11px] font-mono text-stone-500">Heavy Stage Truss</span>
          </div>
          <div id="body-rigging" class="p-4 bg-white <%= riggingItem ? '' : 'hidden' %> space-y-3.5 text-xs">
            <div>
              <label class="block font-semibold uppercase text-stone-700 mb-1">Jumlah / Ukuran <span class="text-red-500">*</span></label>
              <input type="text" name="rigging_qty" placeholder="Misal: 1 Set - 8x6 Meter (Tinggi Tiang 6m)" value="<%= riggingItem ? riggingItem.qty_text : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>>
            </div>
            <div>
              <label class="block font-semibold uppercase text-stone-700 mb-1">Keterangan Teknis <span class="text-red-500">*</span></label>
              <textarea name="rigging_notes" rows="2" placeholder="Catatan: terpal atap rigging, sayap sound (flying), backdrop ram, tangga" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>><%= riggingItem ? riggingItem.notes : '' %></textarea>
            </div>
          </div>
        </div>

        <!-- 5. PANGGUNG (NON-RIGGING / LEVEL) -->
        <% const levelItem = getItem('panggung'); %>
        <div class="border border-stone-300 rounded overflow-hidden">
          <div class="bg-stone-50 px-4 py-3 flex items-center justify-between border-b border-stone-200">
            <label class="inline-flex items-center space-x-2.5 cursor-pointer">
              <input type="checkbox" name="cat_panggung" value="1" <%= levelItem ? 'checked' : '' %> class="cat-toggle" data-target="body-level" <%= isReadOnly ? 'disabled' : '' %>>
              <span class="font-bold text-xs uppercase tracking-wider text-stone-900">5. Panggung (Non-Rigging / Level)</span>
            </label>
            <span class="text-[11px] font-mono text-stone-500">Indoor / Acoustic Stage</span>
          </div>
          <div id="body-level" class="p-4 bg-white <%= levelItem ? '' : 'hidden' %> space-y-3.5 text-xs">
            <div>
              <label class="block font-semibold uppercase text-stone-700 mb-1">Jumlah / Ukuran <span class="text-red-500">*</span></label>
              <input type="text" name="panggung_qty" placeholder="Misal: 1 Set - 6x4 Meter, Tinggi 60cm" value="<%= levelItem ? levelItem.qty_text : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>>
            </div>
            <div>
              <label class="block font-semibold uppercase text-stone-700 mb-1">Keterangan Teknis <span class="text-red-500">*</span></label>
              <textarea name="panggung_notes" rows="2" placeholder="Catatan: karpet hitam/merah, skirting panggung, mini trap tangga" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>><%= levelItem ? levelItem.notes : '' %></textarea>
            </div>
          </div>
        </div>

        <!-- 6. KURSI (MULTI-TIPE BERSYARAT: FUTURA, PLASTIK, SOFA) -->
        <% 
          const futuraItem = getItem('kursi_futura'); const futuraAttr = futuraItem && futuraItem.attributes ? futuraItem.attributes : {};
          const plastikItem = getItem('kursi_plastik'); const plastikAttr = plastikItem && plastikItem.attributes ? plastikItem.attributes : {};
          const sofaItem = getItem('kursi_sofa');
          const hasAnyKursi = Boolean(futuraItem || plastikItem || sofaItem);
        %>
        <div class="border border-stone-300 rounded overflow-hidden">
          <div class="bg-stone-50 px-4 py-3 flex items-center justify-between border-b border-stone-200">
            <label class="inline-flex items-center space-x-2.5 cursor-pointer">
              <input type="checkbox" name="cat_kursi" value="1" <%= hasAnyKursi ? 'checked' : '' %> class="cat-toggle" data-target="body-kursi" <%= isReadOnly ? 'disabled' : '' %>>
              <span class="font-bold text-xs uppercase tracking-wider text-stone-900">6. Kursi (Multi-Tipe: Futura / Plastik / Sofa)</span>
            </label>
            <span class="text-[11px] font-mono text-stone-500">Seating & Covers</span>
          </div>
          <div id="body-kursi" class="p-4 bg-white <%= hasAnyKursi ? '' : 'hidden' %> space-y-4 text-xs">
