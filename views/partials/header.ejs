<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Event Production Manifest</title>
  
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Leaflet CSS for Map -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            stone: {
              50: '#FAFAF9',
              100: '#F5F5F4',
              200: '#E7E5E4',
              300: '#D6D3D1',
              400: '#A8A29E',
              500: '#78716C',
              600: '#57534E',
              700: '#44403C',
              800: '#292524',
              900: '#1C1917',
            },
            amber: {
              600: '#D97706',
              700: '#B45309',
              800: '#92400E',
            },
            emerald: {
              700: '#15803D',
            },
            crimson: {
              700: '#B91C1C',
            }
          }
        }
      }
    }
  </script>

  <!-- Custom Technical Spec CSS -->
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-stone-100 text-stone-900 min-h-screen flex flex-col font-sans">
  <!-- Minimalist Technical Header -->
  <header class="bg-stone-900 text-stone-100 border-b border-stone-800 no-print sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <!-- SVG Tool/Clipboard Icon -->
        <svg class="w-5 h-5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
          <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
          <path d="M9 14h6"></path>
          <path d="M9 10h6"></path>
          <path d="M9 18h4"></path>
        </svg>
        <div class="leading-tight">
          <span class="font-bold text-sm tracking-wide uppercase text-white">Event Spec Sheet</span>
          <span class="hidden sm:inline-block text-xs text-stone-400 font-mono ml-2 border-l border-stone-700 pl-2">PROD-MANIFEST v1.0</span>
        </div>
      </div>

      <div class="flex items-center space-x-3 text-xs">
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a href="/admin" class="text-stone-300 hover:text-white px-2 py-1 rounded hover:bg-stone-800 transition">Dashboard</a>
          <a href="/admin/create-link" class="bg-amber-600 hover:bg-amber-700 text-white font-medium px-3 py-1.5 rounded transition inline-flex items-center space-x-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Buat Link Baru</span>
          </a>
          <a href="/admin/logout" class="text-stone-400 hover:text-red-400 px-2 py-1 rounded transition">Keluar</a>
        <% } else if (typeof link !== 'undefined' && link) { %>
          <span class="font-mono bg-stone-800 text-amber-400 px-2.5 py-1 rounded border border-stone-700 text-xs">
            ID: <%= link.hash_code %>
          </span>
        <% } else { %>
          <span class="text-stone-400 text-xs font-mono">STANDALONE SYSTEM</span>
        <% } %>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-grow">
