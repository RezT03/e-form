<%- include('../partials/header', { title: title || 'Akses Ditolak' }) %>

<div class="max-w-md mx-auto px-4 py-16">
  <div class="tech-sheet p-6 sm:p-8 bg-white border border-stone-300 rounded text-center">
    <!-- Crimson Icon -->
    <div class="w-12 h-12 bg-red-100 text-red-700 rounded-full flex items-center justify-center mx-auto mb-4 border border-red-200">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
    </div>

    <div class="inline-block font-mono text-[11px] uppercase tracking-wider text-red-700 bg-red-50 border border-red-200 px-2.5 py-0.5 rounded mb-2">
      ACCESS RESTRICTED
    </div>

    <h1 class="text-lg font-bold text-stone-900 mb-2">
      <%= heading || 'Link Kedaluwarsa atau Tidak Valid' %>
    </h1>

    <p class="text-xs text-stone-600 mb-6 leading-relaxed">
      <%= message || 'Halaman pemesanan perlengkapan event tidak dapat diakses saat ini. Silakan hubungi admin atau koordinator produksi untuk mendapatkan link baru.' %>
    </p>

    <div class="border-t border-stone-200 pt-5">
      <p class="text-[11px] text-stone-500 font-mono">
        Hubungi tim produksi vendor Anda jika Anda merasa ini adalah kekeliruan.
      </p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
