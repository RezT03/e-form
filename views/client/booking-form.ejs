                <span>A. Kursi Futura</span>
              </label>

              <div id="sub-futura" class="<%= futuraItem ? '' : 'hidden' %> space-y-3 pl-4 border-l-2 border-stone-300">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label class="block font-semibold uppercase text-stone-600 mb-1">Jumlah Unit <span class="text-red-500">*</span></label>
                    <input type="number" id="futura_qty" name="futura_qty" min="1" placeholder="Misal: 100" value="<%= futuraItem ? futuraItem.qty_text : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-mono" <%= isReadOnly ? 'readonly' : '' %>>
                  </div>
                  <div>
                    <label class="block font-semibold uppercase text-stone-600 mb-1">Include Cover? <span class="text-red-500">*</span></label>
                    <select id="futura_cover" name="futura_cover" class="w-full px-3 py-2 border border-stone-300 rounded cover-select" data-scope-target="futura-scope-wrapper" <%= isReadOnly ? 'disabled' : '' %>>
                      <option value="Tidak" <%= futuraAttr.include_cover === false || futuraAttr.include_cover === 'Tidak' ? 'selected' : '' %>>Tidak</option>
                      <option value="Ya" <%= futuraAttr.include_cover === true || futuraAttr.include_cover === 'Ya' ? 'selected' : '' %>>Ya</option>
                    </select>
                  </div>
                </div>

                <!-- Conditional Cover Scope for Futura -->
                <div id="futura-scope-wrapper" class="space-y-3 <%= futuraAttr.include_cover === true || futuraAttr.include_cover === 'Ya' ? '' : 'hidden' %> bg-white p-3 border border-stone-200 rounded">
                  <label class="block font-semibold uppercase text-stone-600">Cakupan Cover Futura</label>
                  <div class="flex items-center space-x-4">
                    <label class="inline-flex items-center space-x-1.5 cursor-pointer">
                      <input type="radio" name="futura_cover_scope" value="all" <%= !futuraAttr.cover_scope || futuraAttr.cover_scope === 'all' ? 'checked' : '' %> class="cover-scope-radio" data-partial-target="futura-partial-wrapper" <%= isReadOnly ? 'disabled' : '' %>>
                      <span>Semua Dicover (<span id="futura-cover-all-label">100%</span>)</span>
                    </label>
                    <label class="inline-flex items-center space-x-1.5 cursor-pointer">
                      <input type="radio" name="futura_cover_scope" value="partial" <%= futuraAttr.cover_scope === 'partial' ? 'checked' : '' %> class="cover-scope-radio" data-partial-target="futura-partial-wrapper" <%= isReadOnly ? 'disabled' : '' %>>
                      <span>Sebagian Dicover</span>
                    </label>
                  </div>
                  <div id="futura-partial-wrapper" class="<%= futuraAttr.cover_scope === 'partial' ? '' : 'hidden' %>">
                    <label class="block font-semibold uppercase text-stone-600 mb-1">Jumlah Kursi yang Dicover <span class="text-red-500">*</span></label>
                    <input type="number" id="futura_cover_qty" name="futura_cover_qty" min="1" placeholder="Jumlah cover (maksimal sesuai unit)" value="<%= futuraAttr.cover_qty || '' %>" class="w-full sm:w-60 px-3 py-2 border border-stone-300 rounded font-mono" <%= isReadOnly ? 'readonly' : '' %>>
                  </div>
                </div>

                <div>
                  <label class="block font-semibold uppercase text-stone-600 mb-1">Keterangan Futura <span class="text-red-500">*</span></label>
                  <input type="text" name="futura_notes" placeholder="Warna cover (putih/hitam), pita kursi, posisi penataan" value="<%= futuraItem ? futuraItem.notes : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>>
                </div>
              </div>
            </div>

            <!-- B. Kursi Plastik -->
            <div class="p-3 bg-stone-50 border border-stone-200 rounded space-y-3">
              <label class="inline-flex items-center space-x-2 font-semibold text-stone-800 cursor-pointer">
                <input type="checkbox" name="kursi_plastik_check" value="1" <%= plastikItem ? 'checked' : '' %> class="kursi-sub-toggle" data-target="sub-plastik" <%= isReadOnly ? 'disabled' : '' %>>
                <span>B. Kursi Plastik</span>
              </label>

              <div id="sub-plastik" class="<%= plastikItem ? '' : 'hidden' %> space-y-3 pl-4 border-l-2 border-stone-300">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label class="block font-semibold uppercase text-stone-600 mb-1">Jumlah Unit <span class="text-red-500">*</span></label>
                    <input type="number" id="plastik_qty" name="plastik_qty" min="1" placeholder="Misal: 200" value="<%= plastikItem ? plastikItem.qty_text : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-mono" <%= isReadOnly ? 'readonly' : '' %>>
                  </div>
                  <div>
                    <label class="block font-semibold uppercase text-stone-600 mb-1">Include Cover? <span class="text-red-500">*</span></label>
                    <select id="plastik_cover" name="plastik_cover" class="w-full px-3 py-2 border border-stone-300 rounded cover-select" data-scope-target="plastik-scope-wrapper" <%= isReadOnly ? 'disabled' : '' %>>
                      <option value="Tidak" <%= plastikAttr.include_cover === false || plastikAttr.include_cover === 'Tidak' ? 'selected' : '' %>>Tidak</option>
                      <option value="Ya" <%= plastikAttr.include_cover === true || plastikAttr.include_cover === 'Ya' ? 'selected' : '' %>>Ya</option>
                    </select>
                  </div>
                </div>

                <!-- Conditional Cover Scope for Plastik -->
                <div id="plastik-scope-wrapper" class="space-y-3 <%= plastikAttr.include_cover === true || plastikAttr.include_cover === 'Ya' ? '' : 'hidden' %> bg-white p-3 border border-stone-200 rounded">
                  <label class="block font-semibold uppercase text-stone-600">Cakupan Cover Plastik</label>
                  <div class="flex items-center space-x-4">
                    <label class="inline-flex items-center space-x-1.5 cursor-pointer">
                      <input type="radio" name="plastik_cover_scope" value="all" <%= !plastikAttr.cover_scope || plastikAttr.cover_scope === 'all' ? 'checked' : '' %> class="cover-scope-radio" data-partial-target="plastik-partial-wrapper" <%= isReadOnly ? 'disabled' : '' %>>
                      <span>Semua Dicover (<span id="plastik-cover-all-label">100%</span>)</span>
                    </label>
                    <label class="inline-flex items-center space-x-1.5 cursor-pointer">
                      <input type="radio" name="plastik_cover_scope" value="partial" <%= plastikAttr.cover_scope === 'partial' ? 'checked' : '' %> class="cover-scope-radio" data-partial-target="plastik-partial-wrapper" <%= isReadOnly ? 'disabled' : '' %>>
                      <span>Sebagian Dicover</span>
                    </label>
                  </div>
                  <div id="plastik-partial-wrapper" class="<%= plastikAttr.cover_scope === 'partial' ? '' : 'hidden' %>">
                    <label class="block font-semibold uppercase text-stone-600 mb-1">Jumlah Kursi yang Dicover <span class="text-red-500">*</span></label>
                    <input type="number" id="plastik_cover_qty" name="plastik_cover_qty" min="1" placeholder="Jumlah cover (maksimal sesuai unit)" value="<%= plastikAttr.cover_qty || '' %>" class="w-full sm:w-60 px-3 py-2 border border-stone-300 rounded font-mono" <%= isReadOnly ? 'readonly' : '' %>>
                  </div>
                </div>

                <div>
                  <label class="block font-semibold uppercase text-stone-600 mb-1">Keterangan Plastik <span class="text-red-500">*</span></label>
                  <input type="text" name="plastik_notes" placeholder="Warna cover atau catatan peletakan" value="<%= plastikItem ? plastikItem.notes : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>>
                </div>
              </div>
            </div>

            <!-- C. Sofa VIP -->
            <div class="p-3 bg-stone-50 border border-stone-200 rounded space-y-3">
              <label class="inline-flex items-center space-x-2 font-semibold text-stone-800 cursor-pointer">
                <input type="checkbox" name="kursi_sofa_check" value="1" <%= sofaItem ? 'checked' : '' %> class="kursi-sub-toggle" data-target="sub-sofa" <%= isReadOnly ? 'disabled' : '' %>>
                <span>C. Sofa (VIP)</span>
              </label>

              <div id="sub-sofa" class="<%= sofaItem ? '' : 'hidden' %> space-y-3 pl-4 border-l-2 border-stone-300">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label class="block font-semibold uppercase text-stone-600 mb-1">Jumlah Unit / Seater <span class="text-red-500">*</span></label>
                    <input type="number" name="sofa_qty" min="1" placeholder="Misal: 4" value="<%= sofaItem ? sofaItem.qty_text : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-mono" <%= isReadOnly ? 'readonly' : '' %>>
                  </div>
                  <div>
                    <label class="block font-semibold uppercase text-stone-600 mb-1">Keterangan Sofa <span class="text-red-500">*</span></label>
                    <input type="text" name="sofa_notes" placeholder="Single seater / double seater, warna hitam/putih" value="<%= sofaItem ? sofaItem.notes : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- 7. MEJA (MULTI-BENTUK: MEJA BULAT & MEJA KOTAK) -->
        <% 
          const bulatItem = getItem('meja_bulat'); 
          const kotakItem = getItem('meja_kotak'); 
          const hasAnyMeja = Boolean(bulatItem || kotakItem);
        %>
        <div class="border border-stone-300 rounded overflow-hidden">
          <div class="bg-stone-50 px-4 py-3 flex items-center justify-between border-b border-stone-200">
            <label class="inline-flex items-center space-x-2.5 cursor-pointer">
              <input type="checkbox" name="cat_meja" value="1" <%= hasAnyMeja ? 'checked' : '' %> class="cat-toggle" data-target="body-meja" <%= isReadOnly ? 'disabled' : '' %>>
              <span class="font-bold text-xs uppercase tracking-wider text-stone-900">7. Meja (Multi-Bentuk: Bulat / Kotak)</span>
            </label>
            <span class="text-[11px] font-mono text-stone-500">Tables & Catering</span>
          </div>
          <div id="body-meja" class="p-4 bg-white <%= hasAnyMeja ? '' : 'hidden' %> space-y-4 text-xs">
            <p class="text-stone-500 text-[11px]">Anda dapat memilih meja bulat, meja kotak, atau keduanya:</p>

            <!-- A. Meja Bulat -->
            <div class="p-3 bg-stone-50 border border-stone-200 rounded space-y-2">
              <label class="inline-flex items-center space-x-2 font-semibold text-stone-800 cursor-pointer">
                <input type="checkbox" name="meja_bulat_check" value="1" <%= bulatItem ? 'checked' : '' %> class="meja-sub-toggle" data-target="sub-bulat" <%= isReadOnly ? 'disabled' : '' %>>
                <span>A. Meja Bulat (Round Table)</span>
              </label>
              <div id="sub-bulat" class="<%= bulatItem ? '' : 'hidden' %> grid grid-cols-1 sm:grid-cols-2 gap-3 pl-4 border-l-2 border-stone-300 pt-1">
                <div>
                  <label class="block font-semibold uppercase text-stone-600 mb-1">Jumlah Unit <span class="text-red-500">*</span></label>
                  <input type="number" name="meja_bulat_qty" min="1" placeholder="Misal: 10" value="<%= bulatItem ? bulatItem.qty_text : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-mono" <%= isReadOnly ? 'readonly' : '' %>>
                </div>
                <div>
                  <label class="block font-semibold uppercase text-stone-600 mb-1">Keterangan <span class="text-red-500">*</span></label>
                  <input type="text" name="meja_bulat_notes" placeholder="Diameter 120cm/160cm, taplak skirting" value="<%= bulatItem ? bulatItem.notes : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>>
                </div>
              </div>
            </div>

            <!-- B. Meja Kotak -->
            <div class="p-3 bg-stone-50 border border-stone-200 rounded space-y-2">
              <label class="inline-flex items-center space-x-2 font-semibold text-stone-800 cursor-pointer">
                <input type="checkbox" name="meja_kotak_check" value="1" <%= kotakItem ? 'checked' : '' %> class="meja-sub-toggle" data-target="sub-kotak" <%= isReadOnly ? 'disabled' : '' %>>
