<%- include('../partials/header', { title: 'Verifikasi Akses | ' + (link.client_name || 'Event Booking') }) %>

<div class="max-w-md mx-auto px-4 py-12 sm:py-16">
  <!-- Technical Spec Sheet Card -->
  <div class="tech-sheet p-6 sm:p-8 bg-white border border-stone-300 rounded shadow-sm">
    <!-- Header with Manifest Code -->
    <div class="border-b border-stone-200 pb-4 mb-6">
      <div class="flex items-center justify-between text-xs font-mono text-stone-500 mb-1">
        <span>SECURITY CLEARANCE</span>
        <span class="bg-stone-100 text-stone-700 px-2 py-0.5 rounded border border-stone-300 font-semibold">
          CODE: <%= link.hash_code %>
        </span>
      </div>
      <h1 class="text-xl font-bold text-stone-900 tracking-tight">Lembar Pemesanan Event</h1>
      <p class="text-xs text-stone-600 mt-1">Konfirmasi identitas pemesan sebelum mengisi formulir manifest teknis.</p>
    </div>

    <!-- Client & Event Confirmation Box -->
    <div class="bg-stone-50 border border-stone-200 rounded p-3.5 mb-6 text-xs space-y-2">
      <div class="flex justify-between">
        <span class="text-stone-500">Nama Pemesan / WO:</span>
        <span class="font-semibold text-stone-900"><%= link.client_name %></span>
      </div>
      <% if (link.event_name) { %>
      <div class="flex justify-between">
        <span class="text-stone-500">Judul / Nama Acara:</span>
        <span class="font-semibold text-stone-900"><%= link.event_name %></span>
      </div>
      <% } %>
      <% if (link.event_type) { %>
      <div class="flex justify-between">
        <span class="text-stone-500">Kategori Event:</span>
        <span class="text-stone-700"><%= link.event_type %></span>
      </div>
      <% } %>
    </div>

    <!-- Alerts if any -->
    <% if (error) { %>
      <div class="bg-red-50 border border-red-300 text-red-800 text-xs px-3.5 py-2.5 rounded mb-5 flex items-start space-x-2">
        <svg class="w-4 h-4 text-red-600 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Password Input Form -->
    <form action="/unlock?user=<%= link.hash_code %>" method="POST" class="space-y-4">
      <input type="hidden" name="user_code" value="<%= link.hash_code %>">
      
      <div>
        <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-stone-700 mb-1.5">
          Password Akses
        </label>
        <div class="relative">
          <input 
            type="password" 
            id="password" 
            name="password" 
            required 
            placeholder="Masukkan password link..."
            class="w-full px-3 py-2.5 text-sm font-mono border border-stone-300 rounded focus:border-amber-600 focus:ring-1 focus:ring-amber-600"
            autocomplete="current-password"
            <%= typeof rateLimited !== 'undefined' && rateLimited ? 'disabled' : 'autofocus' %>
          >
        </div>
        <p class="text-[11px] text-stone-500 mt-1.5">
          Password diberikan oleh vendor produksi atau wedding organizer.
        </p>
      </div>

      <button 
        type="submit" 
        class="w-full bg-amber-600 hover:bg-amber-700 text-white font-medium text-sm py-2.5 px-4 rounded transition flex items-center justify-center space-x-2 disabled:opacity-50"
        <%= typeof rateLimited !== 'undefined' && rateLimited ? 'disabled' : '' %>
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <span>Buka Lembar Pemesanan</span>
      </button>
    </form>

    <div class="mt-6 pt-4 border-t border-stone-200 text-center">
      <span class="text-[11px] text-stone-400 font-mono">ENCRYPTED SPEC SHEET ACCESS &bull; SINGLE LINK ISOLATION</span>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
