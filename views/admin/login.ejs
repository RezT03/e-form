<%- include('../partials/header', { title: 'Admin Login' }) %>

<div class="max-w-md mx-auto px-4 py-16">
  <div class="tech-sheet p-6 sm:p-8 bg-white border border-stone-300 rounded">
    <div class="border-b border-stone-200 pb-4 mb-6">
      <div class="flex items-center space-x-2 text-xs font-mono text-stone-500 mb-1">
        <span>ADMIN CONSOLE</span>
        <span>&bull;</span>
        <span class="text-amber-700 font-bold">MANAGEMENT SYSTEM</span>
      </div>
      <h1 class="text-xl font-bold text-stone-900 tracking-tight">Login Administrator</h1>
      <p class="text-xs text-stone-600 mt-1">Masuk untuk mengelola link booking, pengaturan akses, dan manifest event.</p>
    </div>

    <% if (error) { %>
      <div class="bg-red-50 border border-red-300 text-red-800 text-xs px-3.5 py-2.5 rounded mb-5 flex items-center space-x-2">
        <svg class="w-4 h-4 text-red-600 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" class="space-y-4">
      <div>
        <label for="username" class="block text-xs font-semibold uppercase tracking-wider text-stone-700 mb-1">
          Username Admin
        </label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          required 
          placeholder="admin"
          class="w-full px-3 py-2 text-sm border border-stone-300 rounded font-sans"
          autofocus
        >
      </div>

      <div>
        <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-stone-700 mb-1">
          Password Admin
        </label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          required 
          placeholder="••••••••"
          class="w-full px-3 py-2 text-sm border border-stone-300 rounded font-mono"
        >
      </div>

      <button 
        type="submit" 
        class="w-full bg-stone-900 hover:bg-stone-800 text-white font-medium text-sm py-2.5 px-4 rounded transition flex items-center justify-center space-x-2 shadow-sm"
      >
        <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
        <span>Masuk ke Dashboard</span>
      </button>
    </form>

    <div class="mt-6 pt-4 border-t border-stone-200 text-center">
      <span class="text-[11px] text-stone-400 font-mono">CREDENTIAL PROTECTED &bull; EVENT VENDOR PORTAL</span>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
