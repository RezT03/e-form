              </label>
              <div id="sub-kotak" class="<%= kotakItem ? '' : 'hidden' %> grid grid-cols-1 sm:grid-cols-2 gap-3 pl-4 border-l-2 border-stone-300 pt-1">
                <div>
                  <label class="block font-semibold uppercase text-stone-600 mb-1">Jumlah Unit <span class="text-red-500">*</span></label>
                  <input type="number" name="meja_kotak_qty" min="1" placeholder="Misal: 15" value="<%= kotakItem ? kotakItem.qty_text : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-mono" <%= isReadOnly ? 'readonly' : '' %>>
                </div>
                <div>
                  <label class="block font-semibold uppercase text-stone-600 mb-1">Keterangan <span class="text-red-500">*</span></label>
                  <input type="text" name="meja_kotak_notes" placeholder="Ukuran meja prasmanan / pendaftaran, warna taplak" value="<%= kotakItem ? kotakItem.notes : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- 8. LIGHTING -->
        <% const lightItem = getItem('lighting'); const lightAttr = lightItem && lightItem.attributes ? lightItem.attributes : {}; %>
        <div class="border border-stone-300 rounded overflow-hidden">
          <div class="bg-stone-50 px-4 py-3 flex items-center justify-between border-b border-stone-200">
            <label class="inline-flex items-center space-x-2.5 cursor-pointer">
              <input type="checkbox" name="cat_lighting" value="1" <%= lightItem ? 'checked' : '' %> class="cat-toggle" data-target="body-lighting" <%= isReadOnly ? 'disabled' : '' %>>
              <span class="font-bold text-xs uppercase tracking-wider text-stone-900">8. Lighting</span>
            </label>
            <span class="text-[11px] font-mono text-stone-500">Stage Illumination</span>
          </div>
          <div id="body-lighting" class="p-4 bg-white <%= lightItem ? '' : 'hidden' %> space-y-3.5 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div>
                <label class="block font-semibold uppercase text-stone-700 mb-1">Jumlah / Paket <span class="text-red-500">*</span></label>
                <input type="text" name="lighting_qty" placeholder="Misal: 1 Set - Par LED & Moving Head Beam" value="<%= lightItem ? lightItem.qty_text : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>>
              </div>
              <div>
                <label class="block font-semibold uppercase text-stone-700 mb-1">Include Genset? <span class="text-red-500">*</span></label>
                <select name="lighting_genset" class="w-full px-3 py-2 border border-stone-300 rounded" <%= isReadOnly ? 'disabled' : '' %>>
                  <option value="Tidak" <%= lightAttr.include_genset === false || lightAttr.include_genset === 'Tidak' ? 'selected' : '' %>>Tidak</option>
                  <option value="Ya" <%= lightAttr.include_genset === true || lightAttr.include_genset === 'Ya' ? 'selected' : '' %>>Ya (Include Genset Lighting)</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block font-semibold uppercase text-stone-700 mb-1">Keterangan Teknis <span class="text-red-500">*</span></label>
              <textarea name="lighting_notes" rows="2" placeholder="Catatan: DMX console, follow spot, smoke machine, hazer" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>><%= lightItem ? lightItem.notes : '' %></textarea>
            </div>
          </div>
        </div>

        <!-- 9. BARRIKADE -->
        <% const barrikadeItem = getItem('barrikade'); %>
        <div class="border border-stone-300 rounded overflow-hidden">
          <div class="bg-stone-50 px-4 py-3 flex items-center justify-between border-b border-stone-200">
            <label class="inline-flex items-center space-x-2.5 cursor-pointer">
              <input type="checkbox" name="cat_barrikade" value="1" <%= barrikadeItem ? 'checked' : '' %> class="cat-toggle" data-target="body-barrikade" <%= isReadOnly ? 'disabled' : '' %>>
              <span class="font-bold text-xs uppercase tracking-wider text-stone-900">9. Barrikade</span>
            </label>
            <span class="text-[11px] font-mono text-stone-500">Crowd Control</span>
          </div>
          <div id="body-barrikade" class="p-4 bg-white <%= barrikadeItem ? '' : 'hidden' %> space-y-3.5 text-xs">
            <div>
              <label class="block font-semibold uppercase text-stone-700 mb-1">Jumlah Unit / Panjang Meter <span class="text-red-500">*</span></label>
              <input type="text" name="barrikade_qty" placeholder="Misal: 25 Pcs / 50 Meter" value="<%= barrikadeItem ? barrikadeItem.qty_text : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>>
            </div>
            <div>
              <label class="block font-semibold uppercase text-stone-700 mb-1">Keterangan Teknis <span class="text-red-500">*</span></label>
              <textarea name="barrikade_notes" rows="2" placeholder="Catatan: pagar barrikade besi BRC / barrier mojo / pembatas antrian FOH" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>><%= barrikadeItem ? barrikadeItem.notes : '' %></textarea>
            </div>
          </div>
        </div>

        <!-- 10. GENSET (STANDALONE / TERPISAH) -->
        <% const gensetItem = getItem('genset'); %>
        <div class="border border-stone-300 rounded overflow-hidden">
          <div class="bg-stone-50 px-4 py-3 flex items-center justify-between border-b border-stone-200">
            <label class="inline-flex items-center space-x-2.5 cursor-pointer">
              <input type="checkbox" name="cat_genset" value="1" <%= gensetItem ? 'checked' : '' %> class="cat-toggle" data-target="body-genset" <%= isReadOnly ? 'disabled' : '' %>>
              <span class="font-bold text-xs uppercase tracking-wider text-stone-900">10. Genset (Standalone / Terpisah)</span>
            </label>
            <span class="text-[11px] font-mono text-stone-500">Power Supply</span>
          </div>
          <div id="body-genset" class="p-4 bg-white <%= gensetItem ? '' : 'hidden' %> space-y-3.5 text-xs">
            <div>
              <label class="block font-semibold uppercase text-stone-700 mb-1">Kapasitas (kVA) & Jumlah Unit <span class="text-red-500">*</span></label>
              <input type="text" name="genset_qty" placeholder="Misal: 1 Unit - 60 kVA Silent" value="<%= gensetItem ? gensetItem.qty_text : '' %>" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>>
            </div>
            <div>
              <label class="block font-semibold uppercase text-stone-700 mb-1">Keterangan Teknis <span class="text-red-500">*</span></label>
              <textarea name="genset_notes" rows="2" placeholder="Catatan: durasi standby, include BBM / non BBM, panjang kabel induk meter" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>><%= gensetItem ? gensetItem.notes : '' %></textarea>
            </div>
          </div>
        </div>

        <!-- 11. LAIN-LAIN (DYNAMIC REPEATER) -->
        <% 
          const customItems = getItems('lain_lain');
          const allowCustom = !(link.settings && link.settings.allow_custom_items === false);
        %>
        <div class="border border-stone-300 rounded overflow-hidden">
          <div class="bg-stone-50 px-4 py-3 flex items-center justify-between border-b border-stone-200">
            <label class="inline-flex items-center space-x-2.5 cursor-pointer">
              <input type="checkbox" name="cat_lain_lain" value="1" <%= customItems.length > 0 ? 'checked' : '' %> class="cat-toggle" data-target="body-lain" <%= isReadOnly ? 'disabled' : '' %>>
              <span class="font-bold text-xs uppercase tracking-wider text-stone-900">11. Lain-lain (Custom Equipment)</span>
            </label>
            <span class="text-[11px] font-mono text-stone-500">Additional Requests</span>
          </div>

          <div id="body-lain" class="p-4 bg-white <%= customItems.length > 0 ? '' : 'hidden' %> space-y-3 text-xs">
            <% if (!allowCustom) { %>
              <div class="p-3 bg-stone-100 border border-stone-200 text-stone-600 rounded">
                Admin menonaktifkan penambahan item kustom untuk link ini.
              </div>
            <% } else { %>
              <div id="custom-items-container" class="space-y-3">
                <% if (customItems.length === 0) { %>
                  <!-- Initial empty row if editable -->
                  <% if (!isReadOnly) { %>
                    <div class="custom-item-row p-3 bg-stone-50 border border-stone-200 rounded grid grid-cols-1 sm:grid-cols-12 gap-3 items-start">
                      <div class="sm:col-span-4">
                        <label class="block font-semibold uppercase text-stone-600 mb-1">Nama Perlengkapan <span class="text-red-500">*</span></label>
                        <input type="text" name="custom_name[]" placeholder="Misal: Misty Fan / Kipas Embun" class="w-full px-2.5 py-1.5 border border-stone-300 rounded">
                      </div>
                      <div class="sm:col-span-3">
                        <label class="block font-semibold uppercase text-stone-600 mb-1">Jumlah & Satuan <span class="text-red-500">*</span></label>
                        <input type="text" name="custom_qty[]" placeholder="Misal: 4 Unit" class="w-full px-2.5 py-1.5 border border-stone-300 rounded">
                      </div>
                      <div class="sm:col-span-4">
                        <label class="block font-semibold uppercase text-stone-600 mb-1">Keterangan <span class="text-red-500">*</span></label>
                        <input type="text" name="custom_notes[]" placeholder="Catatan teknis" class="w-full px-2.5 py-1.5 border border-stone-300 rounded">
                      </div>
                      <div class="sm:col-span-1 pt-6 text-center">
                        <button type="button" class="btn-remove-custom text-stone-400 hover:text-red-600">
                          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </button>
                      </div>
                    </div>
                  <% } %>
                <% } else { %>
                  <% customItems.forEach(cItem => { %>
                    <div class="custom-item-row p-3 bg-stone-50 border border-stone-200 rounded grid grid-cols-1 sm:grid-cols-12 gap-3 items-start">
                      <div class="sm:col-span-4">
                        <label class="block font-semibold uppercase text-stone-600 mb-1">Nama Perlengkapan <span class="text-red-500">*</span></label>
                        <input type="text" name="custom_name[]" value="<%= cItem.item_label %>" class="w-full px-2.5 py-1.5 border border-stone-300 rounded" <%= isReadOnly ? 'readonly' : '' %>>
                      </div>
                      <div class="sm:col-span-3">
                        <label class="block font-semibold uppercase text-stone-600 mb-1">Jumlah & Satuan <span class="text-red-500">*</span></label>
                        <input type="text" name="custom_qty[]" value="<%= cItem.qty_text %>" class="w-full px-2.5 py-1.5 border border-stone-300 rounded" <%= isReadOnly ? 'readonly' : '' %>>
                      </div>
                      <div class="sm:col-span-4">
                        <label class="block font-semibold uppercase text-stone-600 mb-1">Keterangan <span class="text-red-500">*</span></label>
                        <input type="text" name="custom_notes[]" value="<%= cItem.notes %>" class="w-full px-2.5 py-1.5 border border-stone-300 rounded" <%= isReadOnly ? 'readonly' : '' %>>
                      </div>
                      <% if (!isReadOnly) { %>
                        <div class="sm:col-span-1 pt-6 text-center">
                          <button type="button" class="btn-remove-custom text-stone-400 hover:text-red-600">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                          </button>
                        </div>
                      <% } %>
                    </div>
                  <% }); %>
                <% } %>
              </div>

              <% if (!isReadOnly) { %>
                <button type="button" id="btn-add-custom-item" class="mt-2 bg-stone-100 hover:bg-stone-200 text-stone-800 border border-stone-300 text-xs font-medium px-3 py-1.5 rounded transition inline-flex items-center space-x-1.5">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                  <span>+ Tambah Perlengkapan Lainnya</span>
                </button>
              <% } %>
            <% } %>
          </div>
        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- SYARAT & KETENTUAN + TOMBOL SUBMIT -->
    <!-- ========================================== -->
    <% if (!isReadOnly) { %>
      <section class="tech-sheet p-6 bg-white border border-stone-300 rounded space-y-4">
        <% const requireTerms = !(link.settings && link.settings.require_terms_agreement === false); %>
        <% if (requireTerms) { %>
          <div class="flex items-start space-x-2.5">
            <input type="checkbox" id="terms-agree" name="terms_agreement" required class="mt-1">
            <label for="terms-agree" class="text-xs text-stone-700 cursor-pointer select-none leading-relaxed">
              Saya menyatakan bahwa rincian jadwal dan daftar spesifikasi perlengkapan di atas adalah benar. Pemesanan ini mengikat sesuai ketentuan teknis vendor produksi event.
            </label>
          </div>
        <% } %>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-stone-200">
          <span class="text-xs text-stone-500 font-mono">
            Pastikan seluruh data terisi lengkap sebelum mengirim.
          </span>
          <button 
            type="submit" 
            id="btn-submit-form"
            class="w-full sm:w-auto bg-amber-600 hover:bg-amber-700 text-white font-medium text-sm px-6 py-2.5 rounded transition flex items-center justify-center space-x-2 shadow-sm <%= requireTerms ? 'opacity-50 pointer-events-none' : '' %>"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
            <span>Kirim & Simpan Lembar Pemesanan</span>
          </button>
        </div>
      </section>
    <% } %>

  </form>
</div>

<!-- Client Form Interactive Script -->
<script src="/js/bookingForm.js"></script>

<%- include('../partials/footer') %>
