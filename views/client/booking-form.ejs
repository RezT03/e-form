              </div>
              <div>
                <label class="block font-semibold uppercase text-stone-700 mb-1">Include Genset? <span class="text-red-500">*</span></label>
                <select name="led_genset" class="w-full px-3 py-2 border border-stone-300 rounded" <%= isReadOnly ? 'disabled' : '' %>>
                  <option value="Tidak" <%= ledAttr.include_genset === false || ledAttr.include_genset === 'Tidak' ? 'selected' : '' %>>Tidak</option>
                  <option value="Ya" <%= ledAttr.include_genset === true || ledAttr.include_genset === 'Ya' ? 'selected' : '' %>>Ya (Include Genset Videotron)</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block font-semibold uppercase text-stone-700 mb-1">Keterangan Teknis <span class="text-red-500">*</span></label>
              <textarea name="led_notes" rows="2" placeholder="Catatan spesifikasi: indoor/outdoor, video processor, switcher, posisi instalasi" class="w-full px-3 py-2 border border-stone-300 rounded font-sans" <%= isReadOnly ? 'readonly' : '' %>><%= ledItem ? ledItem.notes : '' %></textarea>
            </div>
          </div>
        </div>

        <!-- 3. TENDA (TRATAK) -->
        <% const tendaItem = getItem('tenda'); %>
